Algoritmo "Exercícios de algoritmos"
// Disciplina   : [Linguagem e Lógica de Programação]
// Professor   : Gustavo Guanabara 
// Descrição   : Resolução de algoritmos - Sequencias básicas
// Autor(a)    : Lunara Lago
// Data atual  : 01/11/2026
Var
// Seção de Declarações das variáveis 
//Exercício 6
   n, sucessor, antecessor: Inteiro
Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
   Escreva("Digite um número: ")
   Leia(n)
   
   antecessor <- n - 1
   sucessor <- n + 1
   
   Escreval("O seu antecessor é: ", antecessor)
   Escreva("O seu sucessor é: ", sucessor)
Fimalgoritmo