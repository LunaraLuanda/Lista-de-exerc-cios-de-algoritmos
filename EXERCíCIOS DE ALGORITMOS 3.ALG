Algoritmo "Exercícios de algoritmos"
// Disciplina   : [Linguagem e Lógica de Programação]
// Professor   : Gustavo Guanabara
// Descrição   : Resolução de algoritmos - Sequencias básicas
// Autor(a)    : Lunara Lago
// Data atual  : 31/10/2026
Var
// Seção de Declarações das variáveis 
//Exercício 3
   nomeFuncionario: Caractere
   Salario: Real
Inicio
// Seção de Comandos, procedimento, funções, operadores, etc...
   Escreva("Nome do funcionário: ")
   Leia(nomeFuncionario)
   Escreva("Qual o salario dele(a)? ")
   Leia(Salario)
   Escreva("O(A) funcionário ", nomeFuncionario, " tem o salário de ", Salario:6:2)
Fimalgoritmo